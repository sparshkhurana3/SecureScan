# Placeholder allowlist for wollomatic/socket-proxy. M0 allows nothing useful on purpose.
# Spike S2 (M1) derives the exact method + path regexes; M3 pastes them here.
# Variable names follow the wollomatic README (SP_*); verify them against the pinned release.
SP_LISTENIP=0.0.0.0
SP_PROXYPORT=2375
SP_ALLOWFROM=worker
SP_LOGLEVEL=INFO
# SP_ALLOW_GET=...
# SP_ALLOW_POST=...
# SP_ALLOW_DELETE=...
# SP_ALLOWBINDMOUNTFROM=/var/lib/docker/volumes/securescan_data/_data
