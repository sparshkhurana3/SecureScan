# Allowlist for wollomatic/socket-proxy 1.13.1: only what the worker's launcher (backend/securescan/runner/launcher.py)
# sends. Derived from the Docker SDK's request shapes (APIClient with an explicit API version, so every path
# starts with /v1.NN), NOT yet confirmed against a running proxy: spike S2 (spikes/s2/run.sh all) must confirm
# these regexes, whether the proxy matches the query string, and the bind-mount check. See docs/build-notes/M3.md.
#
# What is allowed:
#   GET    /_ping                                  health check
#   GET    /containers/json                        list by label (launcher.list_by_label)
#   GET    /containers/<id|name>/json              inspect (also used by the SDK before reading logs)
#   GET    /containers/<id|name>/logs              stream logs
#   GET    /volumes/securescan_data|securescan_content   daemon-side path of the volumes (bind sources)
#   POST   /containers/create                      create (HostConfig is built from the catalogue only)
#   POST   /containers/<id|name>/start|stop|kill|wait
#   DELETE /containers/<id|name>                   remove (force, with anonymous volumes)
# What is NOT allowed (so the proxy answers 403): exec, attach, networks (none is created at run time), image
# pull or build, volume create, swarm, plugins, system, events, container update/rename/restart/pause, commit.
# <id|name> is a 64-character container id or a name starting with "securescan-"
# (securescan-job-<uuid>, securescan-egress, later securescan-dast-...).
#
# The proxy cannot see inside the request body: the worker alone guarantees that a spec never asks for a
# privileged container, host networking, extra capabilities or host paths (launcher.build_create_body).
SP_LISTENIP=0.0.0.0
SP_PROXYPORT=2375
SP_ALLOWFROM=worker
SP_LOGLEVEL=INFO
SP_ALLOW_GET='(/v1[.][0-9]+)?/(_ping|containers/json)'
SP_ALLOW_GET_2='(/v1[.][0-9]+)?/containers/([0-9a-f]{64}|securescan-[A-Za-z0-9_.-]+)/(json|logs)'
SP_ALLOW_GET_3='(/v1[.][0-9]+)?/volumes/(securescan_data|securescan_content)'
SP_ALLOW_POST='(/v1[.][0-9]+)?/containers/create'
SP_ALLOW_POST_2='(/v1[.][0-9]+)?/containers/([0-9a-f]{64}|securescan-[A-Za-z0-9_.-]+)/(start|stop|kill|wait)'
SP_ALLOW_DELETE='(/v1[.][0-9]+)?/containers/([0-9a-f]{64}|securescan-[A-Za-z0-9_.-]+)'
# Bind sources the daemon may mount into scanner containers: the data volume (workspaces, egress config) and the
# content volume (Semgrep rules, templates). Default Docker root /var/lib/docker; S2 prints the real Mountpoints.
SP_ALLOWBINDMOUNTFROM=/var/lib/docker/volumes/securescan_data/_data,/var/lib/docker/volumes/securescan_content/_data
