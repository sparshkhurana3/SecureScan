# Copy to deploy/.env and adjust. Never commit deploy/.env.
SECURESCAN_PORT=8443
SECURESCAN_PUBLIC_URL=https://securescan.localtest.me:8443
SECURESCAN_DEFECTDOJO_PUBLIC_URL=https://dojo.securescan.localtest.me:8443
SECURESCAN_COOKIE_DOMAIN=securescan.localtest.me

# Microsoft Entra ID (or the mock provider in the dev profile)
SECURESCAN_OIDC_ISSUER=
SECURESCAN_OIDC_CLIENT_ID=

SECURESCAN_LOG_LEVEL=INFO

# DefectDojo (from M4)
DD_IMAGE_REGISTRY=docker.io
DJANGO_VERSION=3.4.0
NGINX_VERSION=3.4.0
# Host name of DefectDojo behind the gateway (no scheme, no port). Must match SECURESCAN_DEFECTDOJO_PUBLIC_URL.
DD_HOST=dojo.securescan.localtest.me
# The bundled PostgreSQL service of the upstream file is disabled; DefectDojo uses the `db` container.
DD_DATABASE_HOST=db
DD_DATABASE_PORT=5432
# DefectDojo's built-in break-glass account. If you change it, set SECURESCAN_DEFECTDOJO_ADMIN_USERNAME to match.
DD_ADMIN_USER=admin
# Not set on purpose: DD_HASHCODE_FIELDS_PER_SCANNER (per-tool deduplication fields) waits for spike S1;
# when it is decided, add it to deploy/defectdojo/override.yaml (see the comment there).

# DAST scope (FR-23). Comma-separated CIDRs a DAST target must resolve into, for example 10.20.0.0/16,192.168.50.0/24.
# Empty: only targets whose host an Admin approved on the target are scanned. Loopback, link-local, the Docker bridge
# networks and cloud metadata addresses are always refused. Restart api and worker after a change.
SECURESCAN_DAST_ALLOWED_CIDRS=
# Highest request rate (requests per second) a target's rate cap may be set to.
SECURESCAN_DAST_MAX_RPS=100

# Host check at worker start: auto (refuse in production, warn in development) | enforce | warn | off.
# SECURESCAN_HOST_CHECK=auto

# Least-privilege socket proxy: run as nobody in the Docker socket's group (gid from `stat -c %g /var/run/docker.sock`).
# SOCKET_PROXY_USER=65534:999

# Backups (scripts/backup.sh reads these from the environment or from this file; see docs/runbooks/restore.md).
# BACKUP_DIR=/var/backups/securescan
# BACKUP_REMOTE=backup@backup-host:/srv/securescan      # or a mounted directory; a backup that stays on this machine is not a success
# BACKUP_REMOTE_METHOD=rsync                            # rsync | scp | copy
# BACKUP_SSH_KEY=/root/.ssh/securescan_backup
# BACKUP_SSH_KNOWN_HOSTS=/root/.ssh/known_hosts
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_AGE_KEY_FILE=deploy/secrets/backup_age_key
# BACKUP_INCLUDE_SECRETS=true
# BACKUP_KEEP_DAYS=7
# BACKUP_METRICS_FILE=/var/lib/node_exporter/textfile/securescan_backup.prom
