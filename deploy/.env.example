# Copy to deploy/.env and adjust. Never commit deploy/.env.
SECURESCAN_PORT=8443
SECURESCAN_PUBLIC_URL=https://securescan.localtest.me:8443
SECURESCAN_DEFECTDOJO_PUBLIC_URL=https://dojo.securescan.localtest.me:8443
SECURESCAN_COOKIE_DOMAIN=securescan.localtest.me

# Microsoft Entra ID (or the mock provider in the dev profile)
SECURESCAN_OIDC_ISSUER=
SECURESCAN_OIDC_CLIENT_ID=

SECURESCAN_LOG_LEVEL=INFO

# DefectDojo (from M4)
DD_IMAGE_REGISTRY=docker.io
DJANGO_VERSION=3.4.0
NGINX_VERSION=3.4.0
