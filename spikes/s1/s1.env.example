# Copy to spikes/s1/.data/s1.env (the .data directory is git-ignored) and edit the password:
#   mkdir -p spikes/s1/.data && cp spikes/s1/s1.env.example spikes/s1/.data/s1.env
# The spike binds DefectDojo to 127.0.0.1 only; use throwaway values.
DD_ADMIN_USER=admin
# Must satisfy DefectDojo's password validators (length, mixed case, digit, symbol).
DD_ADMIN_PASSWORD=ChangeMe-Spike-1!
DD_IMAGE_REGISTRY=docker.io
DJANGO_VERSION=3.4.0
NGINX_VERSION=3.4.0
DD_PORT=8080
DD_TLS_PORT=8443
