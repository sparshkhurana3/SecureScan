# DISCOVERY MODE ONLY: allow every request and log each one at DEBUG, so that derive_paths.py and the proxy log show
# exactly which requests the Docker SDK makes. Never use this file outside the spike.
SP_LISTENIP=0.0.0.0
SP_PROXYPORT=2375
SP_ALLOWFROM=client
SP_LOGLEVEL=DEBUG
SP_ALLOW_GET=.*
SP_ALLOW_HEAD=.*
SP_ALLOW_POST=.*
SP_ALLOW_PUT=.*
SP_ALLOW_PATCH=.*
SP_ALLOW_DELETE=.*
